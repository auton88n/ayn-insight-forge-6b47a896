{
  "manifest_version": 3,
  "name": "AYN Resume Tailor",
  "version": "3.4.6",
  "description": "Read the real job posting, see your match score, tailor your resume, write a cover letter, ask AYN about the job.",
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://ayn.careers/*",
      "https://*.ayn.careers/*",
      "https://*.lovable.app/*",
      "http://localhost/*"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AYN Resume Tailor",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "exclude_matches": [
        "*://*.cloudflare.com/*",
        "*://*.doubleclick.net/*",
        "*://*.googletagmanager.com/*",
        "*://*.google-analytics.com/*",
        "*://*.demdex.net/*",
        "*://*.protechts.net/*",
        "https://www.google.com/recaptcha/*",
        "https://recaptcha.google.com/*",
        "https://www.recaptcha.net/*",
        "https://*.hcaptcha.com/*",
        "https://challenges.cloudflare.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://ayn.careers/handoff*",
        "https://*.ayn.careers/handoff*",
        "https://*.lovable.app/handoff*"
      ],
      "js": [
        "deep-link.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "handoff-hydrate.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "vendor/*"
      ],
      "matches": [
        "https://*/*"
      ]
    }
  ]
}