{
  "manifest_version": 3,
  "name": "AYN Auto-Apply",
  "version": "1.2.0",
  "description": "Fills a real job application from your AYN profile, in your own browser. You always review before anything is submitted.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "Fill this application with AYN"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": ["https://*/*"]
}
