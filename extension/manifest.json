{
  "manifest_version": 3,
  "name": "AYN Resume Tailor",
  "version": "2.8.1",
  "description": "On any job posting in the US or Canada, instantly see your match score, autofill the application, find the recruiter, and tailor your resume. Powered by AYN AI.",
  "key": "",
  "permissions": [
    "activeTab",
    "storage",
    "sidePanel",
    "scripting",
    "webNavigation",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "optional_host_permissions": ["<all_urls>"],

  "externally_connectable": {
    "matches": [
      "https://aynn.io/*",
      "https://*.aynn.io/*",
      "https://*.lovable.app/*",
      "http://localhost/*"
    ]
  },

  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ayn_csp_strip",
        "enabled": true,
        "path": "rules/csp.json"
      }
    ]
  },

  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AYN Resume Tailor",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "exclude_matches": [
        "*://*.cloudflare.com/*",
        "*://*.doubleclick.net/*",
        "*://*.googletagmanager.com/*",
        "*://*.google-analytics.com/*",
        "*://*.demdex.net/*",
        "*://*.protechts.net/*",
        "https://www.google.com/recaptcha/*",
        "https://recaptcha.google.com/*",
        "https://www.recaptcha.net/*",
        "https://*.hcaptcha.com/*",
        "https://challenges.cloudflare.com/*"
      ],
      "js": ["constants.js", "fill-session.js", "question-engine.bundle.js", "content.bundle.js", "filler.js", "dom.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://*/*", "http://*/*"],
      "exclude_matches": [
        "*://*.cloudflare.com/*",
        "*://*.doubleclick.net/*",
        "*://*.googletagmanager.com/*",
        "*://*.google-analytics.com/*",
        "*://*.demdex.net/*",
        "*://*.protechts.net/*",
        "https://www.google.com/recaptcha/*",
        "https://recaptcha.google.com/*",
        "https://www.recaptcha.net/*",
        "https://*.hcaptcha.com/*",
        "https://challenges.cloudflare.com/*"
      ],
      "js": ["page-world.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://aynn.io/handoff*",
        "https://*.aynn.io/handoff*",
        "https://*.lovable.app/handoff*",
        "http://localhost/handoff*"
      ],
      "js": ["deep-link.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["handoff-hydrate.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "web_accessible_resources": [
    { "resources": ["vendor/*"], "matches": ["https://*/*", "http://*/*"] }
  ]
}
