{
  "manifest_version": 3,
  "name": "AYN Resume Tailor",
  "version": "1.0.0",
  "description": "On any job posting, instantly see your keyword match and get a tailored resume in one click. Powered by AYN AI.",
  "permissions": [
    "activeTab",
    "storage",
    "sidePanel",
    "identity"
  ],
  "host_permissions": [
    "https://dfkoxuokfkttjhfjcecx.supabase.co/*",
    "https://*.linkedin.com/*",
    "https://*.indeed.com/*",
    "https://jobright.ai/*",
    "https://*.glassdoor.com/*",
    "https://jobs.lever.co/*",
    "https://boards.greenhouse.io/*",
    "https://jobs.ashbyhq.com/*",
    "https://*.workday.com/*",
    "https://*.greenhouse.io/*",
    "https://*.smartrecruiters.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AYN Resume Tailor",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
