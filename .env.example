# ── AYN Frontend (set in Hostinger → Build Settings → Environment Variables) ──
# Get these from: Supabase Dashboard → Project Settings → API

VITE_SUPABASE_URL=https://dfkoxuokfkttjhfjcecx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional, local dev only. Set to 1 in a local .env.local (gitignored, never
# set here or in any deployed environment) to skip the admin PIN screen for
# an account that is already a genuine admin. import.meta.env.DEV is false in
# every production build regardless of this value, so this cannot reach
# ayn.careers. See src/admin-app/AdminApp.tsx.
# VITE_ADMIN_PIN_DEV_BYPASS=1

# ── Supabase Edge Functions (set in Supabase → Edge Functions → Secrets) ──
# The simulation engine needs these:

# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Auto-set by Supabase — do not change
SUPABASE_URL=https://dfkoxuokfkttjhfjcecx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Optional: Lovable AI Gateway fallback (if no GEMINI_API_KEY)
# LOVABLE_API_KEY=your-lovable-key
