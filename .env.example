# ── AYN Python Backend — Railway Environment Variables ───────────────────────
#
# WHAT'S ALREADY IN RAILWAY:
#   GEMINI_API_KEY      ✅  (already set)
#   SUPABASE_URL        ✅  (already set)
#   SUPABASE_SERVICE_KEY ✅  (already set)
#   PORT                ✅  (Railway sets this automatically)
#
# WHAT YOU NEED TO ADD TO RAILWAY:
#   LOVABLE_API_KEY     ❌  ADD THIS — same key already in your Supabase secrets
#
# HOW IT'S USED:
#   Fast calls (agent reactions, classification, chat)
#     → LOVABLE_API_KEY → ai.gateway.lovable.dev → Gemini Flash
#     → Timeout: 52s (safe for quick calls)
#
#   Long calls (7-layer simulation synthesis, deep analysis)
#     → GEMINI_API_KEY → generativelanguage.googleapis.com direct
#     → Timeout: 5 minutes (no Supabase in the loop)
#
# ─────────────────────────────────────────────────────────────────────────────

# Lovable AI gateway key — copy from your Supabase project secrets (LOVABLE_API_KEY)
LOVABLE_API_KEY=your-lovable-api-key-here

# Gemini direct API key — already in Railway, shown here for local dev
GEMINI_API_KEY=your-gemini-api-key-here

# Supabase
SUPABASE_URL=https://dfkoxuokfkttjhfjcecx.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Proxy secret — must match AYN_PROXY_SECRET in Supabase secrets (if using proxy route)
AYN_PROXY_SECRET=ayn-proxy-2024

# CORS — restrict to your domain in production
# ALLOWED_ORIGINS=https://aynn.io,https://www.aynn.io
